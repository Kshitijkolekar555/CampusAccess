# PICT Gate Security — .gitignore

# ---- Secrets ----
.env
*.env
!*.env.example

# ---- Maven ----
backend/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---- IDE ----
.idea/
*.iml
.vscode/
*.code-workspace
.project
.classpath
.settings/

# ---- Node / Frontend (Phase 8) ----
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Logs & Temporary Scripts ----
*.log
logs/
*.sql
!backend/src/main/resources/db/migration/*.sql
backend_logs*.txt
__pycache__/
*.pyc
face-service/face_service.db
backend/uploads/
*.onnx

face-service/faces.db
