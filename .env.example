# ============================================================
# .env.example — Environment variable template
#
# INSTRUCTIONS:
#   cp .env.example .env
#   Fill in all values — never commit the .env file to git.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=gatesecurity
POSTGRES_USER=gatesecurity_user
POSTGRES_PASSWORD=change_me_strong_password_here

# ---- JWT ----
# Must be at least 256 bits (32+ characters). Use a random generator:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_generate_a_256_bit_secret_key_here

# ---- CORS ----
# Set to your frontend URL. No trailing slash. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Backend Profile ----
# Options: local | dev | prod
SPRING_PROFILES_ACTIVE=local
